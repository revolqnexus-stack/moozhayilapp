# Local API connected to cloud Neon + Upstash (staging mode).
# Generate the real file:  powershell -File ../../scripts/sync-cloud-env.ps1
# Then run:  npm run dev:cloud

NODE_ENV=staging
PORT=3080
TRUST_PROXY=false
LOG_LEVEL=info

# Paste from PRODUCTION_ENV.txt (Neon pooler URL, sslmode=require)
DATABASE_URL=postgresql://USER:PASS@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Paste from PRODUCTION_ENV.txt (Upstash)
REDIS_URL=redis://default:TOKEN@xxxx.upstash.io:6379

# Paste security secrets from PRODUCTION_ENV.txt
JWT_SECRET=
JWT_REFRESH_SECRET=
OTP_HASH_SECRET=
PII_ENCRYPTION_SECRET=
ADMIN_JWT_SECRET=
KYC_WEBHOOK_SECRET=
GOLD_RATE_WEBHOOK_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5173,http://localhost:3080,http://10.0.2.2:3080
PUBLIC_BASE_URL=http://localhost:3080

# Staging: mock providers (OTP logged in API console; KYC OTP 654321 in dev docs)
SMS_PROVIDER_MODE=mock
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=6abb8a19a03188ad0c03da42
MSG91_DLT_PE_ID=1001435730734881903
MSG91_DLT_TE_ID=1077188560121746406

KYC_PROVIDER_MODE=mock
KYC_PROVIDER_BASE_URL=
KYC_PROVIDER_API_KEY=
KYC_UPLOAD_DIR=./uploads/kyc
MEDIA_UPLOAD_DIR=./uploads/media

STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

PAYMENT_PROVIDER=razorpay
PAYMENT_PROVIDER_MODE=mock

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FIREBASE_MODE=mock
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

ENABLE_DEMO_SEEDS=false
WORKER_HEALTH_PORT=3001

ADMIN_SEED_EMAIL=admin@moozhayil.com
ADMIN_SEED_PASSWORD=change_me_before_running_seed_admin
ADMIN_SEED_NAME=Moozhayil Admin
ADMIN_SEED_ROLE=super_admin
